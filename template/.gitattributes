# Normalize line endings — LF everywhere in the repo, CRLF only at checkout
# on Windows for Windows-specific files.
* text=auto eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.parquet binary
*.pkl binary
*.h5 binary

# Language-specific
*.py text diff=python
*.md text diff=markdown
